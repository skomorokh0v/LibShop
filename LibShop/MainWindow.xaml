<Window x:Class="LibShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:LibShop"
        mc:Ignorable="d"
        Title="LibShop — книжный магазин"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка: динамический заголовок страницы + кнопки управления -->
        <materialDesign:ColorZone Grid.Row="0"
                                   Mode="PrimaryMid"
                                   Padding="8">
            <DockPanel>
                <!-- Динамический заголовок страницы -->
                <TextBlock x:Name="PageTitleText"
                           DockPanel.Dock="Left"
                           Text="Авторизация"
                           Style="{StaticResource AppPageTitle}" />

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- Информация о вошедшем пользователе -->
                    <TextBlock x:Name="UserText"
                               Text=""
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource MaterialDesign.Brush.OnPrimary}" />

                    <!-- Смена пароля -->
                    <Button x:Name="ChangePasswordButton"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="36" MinWidth="44" Margin="2"
                            Foreground="White"
                            BorderBrush="#B3FFFFFF"
                            ToolTip="Сменить пароль текущего пользователя"
                            Click="ChangePasswordButton_Click">
                        <materialDesign:PackIcon Kind="KeyVariant" Width="20" Height="20" />
                    </Button>

                    <!-- Смена темы приложения -->
                    <Button x:Name="ThemeButton"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="36" MinWidth="44" Margin="2"
                            Foreground="White"
                            BorderBrush="#B3FFFFFF"
                            ToolTip="Переключить светлую/тёмную тему"
                            Click="ThemeButton_Click">
                        <materialDesign:PackIcon x:Name="ThemeIcon"
                                                 Kind="WeatherNight"
                                                 Width="20" Height="20" />
                    </Button>

                    <!-- Выход из системы -->
                    <Button x:Name="LogoutButton"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="36" MinWidth="44" Margin="2"
                            Foreground="White"
                            Background="#193D57"
                            ToolTip="Выйти из системы"
                            Click="LogoutButton_Click">
                        <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Контент страниц (авторизация / пользователь / администратор) -->
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden" />
    </Grid>
</Window>
