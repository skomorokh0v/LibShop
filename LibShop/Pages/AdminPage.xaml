<Page x:Class="LibShop.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:LibShop"
      mc:Ignorable="d"
      Title="Панель администратора"
      FontFamily="{StaticResource AppFont}"
      Loaded="Page_Loaded">
    <TabControl Style="{StaticResource MaterialDesignTabControl}"
                Margin="8">

        <!-- ==================== Книги ==================== -->
        <TabItem Header="Книги">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Поиск, сортировка, фильтрация -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBox x:Name="BookSearchTextBox"
                             Style="{StaticResource AppSearchBox}"
                             materialDesign:HintAssist.Hint="Поиск по названию/автору"
                             TextChanged="BookFilters_Changed" />
                    <ComboBox x:Name="BookGenreComboBox"
                              Style="{StaticResource AppComboBox}"
                              Width="190"
                              materialDesign:HintAssist.Hint="Жанр"
                              SelectionChanged="BookFilters_Changed" />
                    <ComboBox x:Name="BookSortComboBox"
                              Style="{StaticResource AppComboBox}"
                              Width="230"
                              materialDesign:HintAssist.Hint="Сортировка"
                              SelectionChanged="BookFilters_Changed" />
                    <Button Content="Сбросить"
                            Style="{StaticResource AppLogoutButton}"
                           
                            Click="BookResetFilters_Click" />
                </WrapPanel>

                <DataGrid x:Name="BooksGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="45" />
                        <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                        <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="*" />
                        <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="*" />
                        <DataGridTextColumn Header="Издательство" Binding="{Binding Publisher}" Width="*" />
                        <DataGridTextColumn Header="Год" Binding="{Binding PublicationYear}" Width="75" />
                        <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="90" />
                        <DataGridTextColumn Header="В наличии" Binding="{Binding Quantity}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Left" Content="Добавить"
                            Style="{StaticResource AppButton}"
                            Click="AddBookButton_Click" />
                    <Button DockPanel.Dock="Left" Content="Редактировать"
                            Style="{StaticResource AppLogoutButton}"
                            Click="EditBookButton_Click" />
                    <Button DockPanel.Dock="Left" Content="Удалить"
                            Style="{StaticResource AppLogoutButton}"
                            ToolTip="Удаление книги удаляет связанные заказы (каскадно)"
                            Click="DeleteBookButton_Click" />
                    <Button DockPanel.Dock="Left" Content="Обновить"
                            Style="{StaticResource AppLogoutButton}"
                            Click="RefreshBooks_Click" />
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- ==================== Пользователи ==================== -->
        <TabItem Header="Пользователи">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBox x:Name="UserSearchTextBox"
                             Style="{StaticResource AppSearchBox}"
                             materialDesign:HintAssist.Hint="Поиск по логину/ФИО"
                             TextChanged="UserFilters_Changed" />
                    <ComboBox x:Name="UserRoleComboBox"
                              Style="{StaticResource AppComboBox}"
                              Width="190"
                              materialDesign:HintAssist.Hint="Роль"
                              SelectionChanged="UserFilters_Changed" />
                    <ComboBox x:Name="UserSortComboBox"
                              Style="{StaticResource AppComboBox}"
                              Width="230"
                              materialDesign:HintAssist.Hint="Сортировка"
                              ToolTip="Сортировка списка пользователей"
                              SelectionChanged="UserFilters_Changed" />
                    <Button Content="Сбросить"
                            Style="{StaticResource AppLogoutButton}"
                           
                            Click="UserResetFilters_Click" />
                </WrapPanel>

                <DataGrid x:Name="UsersGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="45" />
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*" />
                        <DataGridTextColumn Header="Фамилия и имя" Binding="{Binding FullName}" Width="2*" />
                        <DataGridTextColumn Header="Электронная почта" Binding="{Binding Email}" Width="*" />
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*" />
                        <DataGridTextColumn Header="Роль" Binding="{Binding RoleDescription}" Width="*" />
                        <DataGridTextColumn Header="Дата регистрации" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Left" Content="Добавить"
                            Style="{StaticResource AppButton}"
                            Click="AddUserButton_Click" />
                    <Button DockPanel.Dock="Left" Content="Редактировать"
                            Style="{StaticResource AppLogoutButton}"
                            ToolTip="Пустое поле пароля — пароль не меняется"
                            Click="EditUserButton_Click" />
                    <Button DockPanel.Dock="Left" Content="Удалить"
                            Style="{StaticResource AppLogoutButton}"
                            ToolTip="Удаление пользователя удаляет его заказы (каскадно)"
                            Click="DeleteUserButton_Click" />
                    <Button DockPanel.Dock="Left" Content="Обновить"
                            Style="{StaticResource AppLogoutButton}"
                            Click="RefreshUsers_Click" />
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- ==================== Заказы ==================== -->
        <TabItem Header="Заказы">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBox x:Name="OrderSearchTextBox"
                             Style="{StaticResource AppSearchBox}"
                             materialDesign:HintAssist.Hint="Поиск по пользователю/книге"
                             TextChanged="OrderFilters_Changed" />
                    <ComboBox x:Name="OrderStatusComboBox"
                              Style="{StaticResource AppComboBox}"
                              Width="190"
                              materialDesign:HintAssist.Hint="Статус"
                              SelectionChanged="OrderFilters_Changed" />
                    <ComboBox x:Name="OrderSortComboBox"
                              Style="{StaticResource AppComboBox}"
                              Width="230"
                              materialDesign:HintAssist.Hint="Сортировка"
                              ToolTip="Сортировка списка заказов"
                              SelectionChanged="OrderFilters_Changed" />
                    <Button Content="Сбросить"
                            Style="{StaticResource AppLogoutButton}"
                           
                            Click="OrderResetFilters_Click" />
                </WrapPanel>

                <DataGrid x:Name="OrdersGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="45" />
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding User.Login}" Width="*" />
                        <DataGridTextColumn Header="Книга" Binding="{Binding Book.Title}" Width="2*" />
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="65" />
                        <DataGridTextColumn Header="Цена, ₽" Binding="{Binding UnitPrice, StringFormat={}{0:F2}}" Width="85" />
                        <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding TotalPrice, StringFormat={}{0:F2}}" Width="95" />
                        <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy HH:mm}" Width="125" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusDescription}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Left" Content="Оплатить"
                            Style="{StaticResource AppButton}"
                            ToolTip="Отметить выбранный заказ оплаченным"
                            Click="PayOrderButton_Click" />
                    <Button DockPanel.Dock="Left" Content="Отменить"
                            Style="{StaticResource AppLogoutButton}"
                            Click="CancelOrderButton_Click" />
                    <Button DockPanel.Dock="Left" Content="Удалить"
                            Style="{StaticResource AppLogoutButton}"
                            ToolTip="Удалить выбранный заказ"
                            Click="DeleteOrderButton_Click" />
                    <Button DockPanel.Dock="Left" Content="Обновить"
                            Style="{StaticResource AppLogoutButton}"
                            Click="RefreshOrders_Click" />
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- ==================== Диаграмма ==================== -->
        <TabItem Header="Диаграмма">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox x:Name="ChartModeComboBox"
                              Style="{StaticResource AppComboBox}"
                              Width="300"
                              ToolTip="Выберите, что отобразить на диаграмме"
                              SelectionChanged="ChartMode_Changed" />
                    <Button Content="Обновить"
                            Style="{StaticResource AppLogoutButton}"
                           
                            Click="RefreshChart_Click" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChartItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,0" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding ValueLabel}"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource AppHint}" />
                                    <Rectangle Fill="{DynamicResource MaterialDesign.Brush.Primary}"
                                               Width="42"
                                               Height="{Binding BarHeight}"
                                               RadiusX="4" RadiusY="4"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Label}"
                                               HorizontalAlignment="Center"
                                               MaxWidth="90"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Style="{StaticResource AppHint}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- ==================== Отчёты ==================== -->
        <TabItem Header="Отчёты">
            <StackPanel MaxWidth="560" HorizontalAlignment="Center" Margin="0,24,0,0">

                <materialDesign:Card Padding="24">
                    <StackPanel>
                        <TextBlock Text="Экспорт отчётов"
                                   Style="{StaticResource AppSectionTitle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource AppHint}"
                                   Margin="4,0,4,12"
                                   Text="Отчёт формируется по всем заказам магазина. Выберите формат: .xlsx (Excel), .docx (Word) или .pdf." />

                        <Button Content="Отчёт по заказам в Excel (.xlsx)"
                                Style="{StaticResource AppButton}"
                                HorizontalAlignment="Center"
                                Click="ExportXlsxButton_Click" />
                        <Button Content="Отчёт по заказам в Word (.docx)"
                                Style="{StaticResource AppButton}"
                                HorizontalAlignment="Center"
                                Click="ExportDocxButton_Click" />
                        <Button Content="Отчёт по заказам в PDF (.pdf)"
                                Style="{StaticResource AppButton}"
                                HorizontalAlignment="Center"
                                Click="ExportPdfButton_Click" />
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </TabItem>

    </TabControl>
</Page>
