<Page x:Class="LibShop.Pages.ChangePasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:LibShop"
      mc:Ignorable="d"
      Title="Смена пароля"
      FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="460" HorizontalAlignment="Center" Margin="0,30,0,30">

            <materialDesign:Card Padding="24">
                <StackPanel>

                    <TextBlock Text="Смена пароля"
                               Style="{StaticResource AppSectionTitle}"
                               HorizontalAlignment="Center" />

                    <TextBlock Style="{StaticResource AppHint}" Margin="4,0,4,12"
                               Text="Новый пароль: минимум 6 символов, содержит хотя бы одну букву и одну цифру." />

                    <PasswordBox x:Name="CurrentPasswordBox"
                                 Style="{StaticResource AppPasswordBox}"
                                 materialDesign:HintAssist.Hint="Текущий пароль" />

                    <PasswordBox x:Name="NewPasswordBox"
                                 Style="{StaticResource AppPasswordBox}"
                                 materialDesign:HintAssist.Hint="Новый пароль" />

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Style="{StaticResource AppPasswordBox}"
                                 materialDesign:HintAssist.Hint="Повторите новый пароль" />

                    <TextBlock x:Name="ErrorText"
                               Style="{StaticResource AppValidationError}"
                               Margin="4,8,4,0" />

                    <Button Content="Сменить пароль"
                            Style="{StaticResource AppButton}"
                            HorizontalAlignment="Center"
                            Margin="4,16,4,4"
                            Click="ChangeButton_Click" />

                    <Button Content="Назад"
                            Style="{StaticResource AppLogoutButton}"
                            HorizontalAlignment="Center"
                            Click="BackButton_Click" />

                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</Page>