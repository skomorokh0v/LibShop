<Window x:Class="LibShop.Pages.BookEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Книга"
        Height="580" Width="470"
        MinHeight="420" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource AppFont}">
    <DockPanel Margin="16">

        <!-- Ошибка валидации и кнопки закреплены внизу окна:
             видны всегда, даже если поля не помещаются в текущий размер. -->
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource AppValidationError}"
                       Margin="4,8,4,0" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                <Button Content="Сохранить"
                        Style="{StaticResource AppButton}"
                        Click="SaveButton_Click" />
                <Button Content="Отмена"
                        Style="{StaticResource AppLogoutButton}"
                        Click="CancelButton_Click" />
            </StackPanel>
        </StackPanel>

        <!-- Поля ввода: при нехватке места окно прокручивается,
             при увеличении окна поля растягиваются на всю ширину. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <TextBlock x:Name="TitleLabel"
                           Text="Добавление книги"
                           Style="{StaticResource AppSectionTitle}"
                           HorizontalAlignment="Center" />

                <TextBox x:Name="TitleTextBox"
                         Style="{StaticResource AppTextBox}"
                         materialDesign:HintAssist.Hint="Название *"
                         ToolTip="Название книги (обязательно, до 200 символов)"
                         MaxLength="200" />

                <TextBox x:Name="AuthorTextBox"
                         Style="{StaticResource AppTextBox}"
                         materialDesign:HintAssist.Hint="Автор *"
                         ToolTip="Автор книги (обязательно, до 100 символов)"
                         MaxLength="100" />

                <TextBox x:Name="GenreTextBox"
                         Style="{StaticResource AppTextBox}"
                         materialDesign:HintAssist.Hint="Жанр *"
                         ToolTip="Жанр книги (обязательно, до 50 символов)"
                         MaxLength="50" />

                <TextBox x:Name="PublisherTextBox"
                         Style="{StaticResource AppTextBox}"
                         materialDesign:HintAssist.Hint="Издательство"
                         ToolTip="Издательство (необязательно, до 100 символов)"
                         MaxLength="100" />

                <!-- Год / Цена / Количество: адаптивные колонки вместо фиксированной
                     ширины 130, чтобы поля не обрезались краем окна -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             x:Name="YearTextBox"
                             Style="{StaticResource AppTextBox}"
                             materialDesign:HintAssist.Hint="Год издания *"
                             ToolTip="Год издания: целое число от 1000 до 2100"
                             MaxLength="4"
                             PreviewTextInput="DigitsOnly_PreviewTextInput" />
                    <TextBox Grid.Column="1"
                             x:Name="PriceTextBox"
                             Style="{StaticResource AppTextBox}"
                             materialDesign:HintAssist.Hint="Цена, ₽ *"
                             ToolTip="Цена: до 2 знаков после запятой, от 0 до 1 000 000"
                             MaxLength="12"
                             PreviewTextInput="Price_PreviewTextInput" />
                    <TextBox Grid.Column="2"
                             x:Name="QuantityTextBox"
                             Style="{StaticResource AppTextBox}"
                             materialDesign:HintAssist.Hint="Кол-во *"
                             ToolTip="Количество экземпляров: целое число от 0 до 100000"
                             MaxLength="6"
                             PreviewTextInput="DigitsOnly_PreviewTextInput" />
                </Grid>

                <TextBox x:Name="DescriptionTextBox"
                         Style="{StaticResource AppTextBox}"
                         Height="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         materialDesign:HintAssist.Hint="Описание"
                         ToolTip="Краткое описание книги (необязательно, до 1000 символов)"
                         MaxLength="1000" />

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>