<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--
        Собственный словарь стилей (Словарь стилей приложения LibShop).
        Единый шрифт и единые размеры кнопок по всей программе.
    -->

    <!-- Единый шрифт всего приложения -->
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>

    <!-- Стиль кнопки: одинаковая высота и ширина во всём приложении -->
    <Style x:Key="AppButton" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- Компактная кнопка (в строках таблиц) — та же высота, меньшая ширина -->
    <Style x:Key="AppButtonSmall" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Кнопка выхода из системы / приложения -->
    <Style x:Key="AppLogoutButton" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <!-- Единый стиль полей ввода -->
    <Style x:Key="AppTextBox" TargetType="TextBox"
           BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="1" />
        <Setter Property="materialDesign:HintAssist.Foreground"
                Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </Style>

    <!-- Единый стиль полей ввода пароля -->
    <Style x:Key="AppPasswordBox" TargetType="PasswordBox"
           BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="1" />
        <Setter Property="materialDesign:HintAssist.Foreground"
                Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </Style>

    <!-- Единый стиль выпадающих списков -->
    <Style x:Key="AppComboBox" TargetType="ComboBox"
           BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <!-- Заголовок страницы (динамический, в шапке окна) -->
    <Style x:Key="AppPageTitle" TargetType="TextBlock"
           BasedOn="{StaticResource MaterialDesignHeadlineSmallTextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.OnPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="16,0" />
    </Style>

    <!-- Подзаголовок внутри страниц -->
    <Style x:Key="AppSectionTitle" TargetType="TextBlock"
           BasedOn="{StaticResource MaterialDesignTitleLargeTextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Margin" Value="4,8,4,4" />
    </Style>

    <!-- Единый стиль текстовых подсказок -->
    <Style x:Key="AppHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="4,0,4,4" />
    </Style>

    <!-- Подсказка об ошибке валидации -->
    <Style x:Key="AppValidationError" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="4,0,4,4" />
    </Style>

    <!-- Текстовое поле поиска (ограниченная ширина) -->
    <Style x:Key="AppSearchBox" TargetType="TextBox"
           BasedOn="{StaticResource AppTextBox}">
        <Setter Property="Width" Value="260" />
    </Style>

    <!-- Стиль текстовых блоков данных в карточках -->
    <Style x:Key="AppCardText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="2" />
    </Style>

</ResourceDictionary>


